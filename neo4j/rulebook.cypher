MATCH (a:Article {id:"NL:T2:1"}), (o:Obligation {key:"ownership_structure"}) MERGE (a)-[x:IMPOSES]->(o) SET x.condition="risk_based", x.strength="implied", x.quote="identify the ultimate beneficial owner of the client and take reasonable measures to verify his identity, where the client is a legal person, take reasonable measures to gain insight into the ownership and control structure of the client, and where the ultimate beneficial owner is a member of the senior managing officials, take the necessary reasonable measures to verify the identity of the natura";
