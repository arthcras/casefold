MATCH (a:Article {id:"NL:T5:2"}), (o:Obligation {key:"source_of_wealth"}) MERGE (a)-[x:IMPOSES]->(o) SET x.condition="risk_based", x.strength="implied", x.quote="collecting information on the origin of the funds used in that business relationship or transaction and the source of wealth of those clients and of those ultimate beneficial owners;";
