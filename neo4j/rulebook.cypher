// Generated from data/rulebook/*.json by casefold/rulebook_to_cypher.py
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Jurisdiction) REQUIRE n.code IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Law) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Article) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Obligation) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:DocumentType) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:LegalForm) REQUIRE n.id IS UNIQUE;
MERGE (j:Jurisdiction {code:"NL"}) SET j.name="Netherlands";
MERGE (x:DocumentType {key:"authority_to_act"}) SET x.name="Board resolution / power of attorney for signatories", x.scope="entity", x.issuer="entity or notary", x.tier=2;
MERGE (x:DocumentType {key:"business_plan"}) SET x.name="Business plan / description of activities", x.scope="entity", x.issuer="client", x.tier=4;
MERGE (x:DocumentType {key:"constitutional"}) SET x.name="Articles / statutes / constitution / by-laws", x.scope="entity", x.issuer="notary or registry", x.tier=2;
MERGE (x:DocumentType {key:"directors_list"}) SET x.name="List / register of directors", x.scope="entity", x.issuer="entity or register", x.tier=2;
MERGE (x:DocumentType {key:"financial_statements"}) SET x.name="Financial statements / annual accounts", x.scope="entity", x.issuer="entity / auditor", x.tier=2;
MERGE (x:DocumentType {key:"other"}) SET x.name="Other document", x.scope="both", x.issuer="", x.tier=4;
MERGE (x:DocumentType {key:"person_id"}) SET x.name="Identity document (passport / national ID)", x.scope="person", x.issuer="state authority", x.tier=1;
MERGE (x:DocumentType {key:"proof_of_address"}) SET x.name="Proof of address", x.scope="person", x.issuer="utility / bank / authority", x.tier=2;
MERGE (x:DocumentType {key:"questionnaire"}) SET x.name="Client questionnaire / application form", x.scope="both", x.issuer="client (signed)", x.tier=3;
MERGE (x:DocumentType {key:"register_extract"}) SET x.name="Commercial register extract", x.scope="entity", x.issuer="official register", x.tier=1;
MERGE (x:DocumentType {key:"screening_record"}) SET x.name="PEP and sanctions screening record", x.scope="both", x.issuer="obliged entity", x.tier=2;
MERGE (x:DocumentType {key:"shareholder_register"}) SET x.name="Share register / register of members", x.scope="entity", x.issuer="entity", x.tier=3;
MERGE (x:DocumentType {key:"source_of_funds"}) SET x.name="Source of funds evidence (origin of the money in this relationship / transaction)", x.scope="both", x.issuer="bank / third party / client", x.tier=3;
MERGE (x:DocumentType {key:"source_of_wealth"}) SET x.name="Source of wealth evidence (how the total wealth was built up: composition of assets)", x.scope="person", x.issuer="bank / employer / notary / tax return / client", x.tier=3;
MERGE (x:DocumentType {key:"structure_chart"}) SET x.name="Structure chart", x.scope="entity", x.issuer="entity (signed)", x.tier=3;
MERGE (x:DocumentType {key:"trust_deed"}) SET x.name="Trust deed / foundation charter", x.scope="entity", x.issuer="settlor / notary", x.tier=2;
MERGE (x:DocumentType {key:"ubo_declaration"}) SET x.name="Beneficial owner declaration / ownership chart", x.scope="entity", x.issuer="entity (signed)", x.tier=3;
MERGE (x:DocumentType {key:"ubo_register_extract"}) SET x.name="Beneficial owner register extract", x.scope="entity", x.issuer="official register", x.tier=1;
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:Law {id:"NL:wtt2018"}) SET x.short="Wtt 2018", x.title="Act on the Supervision of Trust Offices 2018", x.title_local="Wet toezicht trustkantoren 2018 (Wtt 2018)", x.url="https://wetten.overheid.nl/BWBR0041259" MERGE (x)-[:OF]->(j);
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:Law {id:"NL:wwft"}) SET x.short="Wwft", x.title="Money Laundering and Terrorist Financing (Prevention) Act", x.title_local="Wet ter voorkoming van witwassen en financieren van terrorisme (Wwft)", x.url="https://wetten.overheid.nl/BWBR0024282" MERGE (x)-[:OF]->(j);
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:Law {id:"NL:uitvoeringsbesluit-wwft"}) SET x.short="Uitvoeringsbesluit Wwft 2018", x.title="Uitvoeringsbesluit Wwft 2018", x.title_local="Uitvoeringsbesluit Wwft 2018", x.url="https://wetten.overheid.nl/BWBR0041193/2026-04-30/" MERGE (x)-[:OF]->(j);
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:Law {id:"NL:dnb-gp-wtt"}) SET x.short="DNB Good Practices Wtt 2018", x.title="DNB Good Practices Wtt 2018", x.title_local="", x.url="https://www.dnb.nl/media/tu5l3quf/dnb-good-practice-wtt-2018-nl.pdf" MERGE (x)-[:OF]->(j);
MERGE (x:Article {id:"NL:T1:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 1 en lid 2 aanhef en onder a", x.topic="Customer due diligence", x.lang="nl", x.text_local="1. Een instelling verricht ter voorkoming van witwassen en financieren van terrorisme cliëntenonderzoek. […] 2. Het cliëntenonderzoek stelt de instelling in staat om: a. de cliënt te identificeren en diens identiteit te verifiëren;", x.text_en="1. An institution shall carry out customer due diligence in order to prevent money laundering and terrorist financing. […] 2. The customer due diligence enables the institution to: a. identify the client and verify his identity;", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024282/2026-07-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T1:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T1:2"}) SET x.jurisdiction="NL", x.ref="Wwft art. 4 lid 1; art. 11 lid 1", x.topic="Customer due diligence", x.lang="nl", x.text_local="Art. 4 lid 1: Een instelling voldoet aan artikel 3, tweede lid, onderdelen a en b, en indien van toepassing het derde en vierde lid van dat artikel, voordat de zakelijke relatie wordt aangegaan of een incidentele transactie als bedoeld in artikel 3, vijfde lid, onderdelen b en g, zesde en zevende lid, wordt uitgevoerd. Art. 11 lid 1: Indien de cliënt, de insteller van een trust, de trustee van een trust, de vennoot van een personenvennootschap of de persoon bevoegd inzake het beheer van de personenvennootschap een natuurlijke persoon is, wordt diens identiteit geverifieerd aan de hand van documenten, gegevens of inlichtingen uit betrouwbare en onafhankelijke bron. […]", x.text_en="Art. 4(1): An institution shall comply with article 3, second paragraph, parts a and b, and where applicable the third and fourth paragraph of that article, before the business relationship is entered into or an occasional transaction as referred to in article 3, fifth paragraph, parts b and g, sixth and seventh paragraph, is carried out. Art. 11(1): If the client, the settlor of a trust, the trustee of a trust, the partner of a partnership or the person authorised in the management of the partnership is a natural person, his identity shall be verified on the basis of documents, data or information from a reliable and independent source. […]", x.en_type="own", x.source_url="https://www.viajuridica.nl/informatiesoorten/wet-en-regelgeving/wet-ter-voorkoming-van-witwassen-en-financieren-van-terrorisme", x.verify=true;
MATCH (x:Article {id:"NL:T1:2"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T2:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 2 onder b", x.topic="Beneficial owner", x.lang="nl", x.text_local="b. de uiteindelijk belanghebbende van de cliënt te identificeren en redelijke maatregelen te nemen om zijn identiteit te verifiëren, indien de cliënt een rechtspersoon is, redelijke maatregelen te nemen om inzicht te verwerven in de eigendoms- en zeggenschapsstructuur van de cliënt, en indien de uiteindelijk belanghebbende lid is van het hoger leidinggevend personeel, noodzakelijke redelijke maatregelen te nemen om de identiteit te verifiëren van de natuurlijke persoon die lid is van het hoger leidinggevend personeel, waarbij de genomen maatregelen en de ondervonden moeilijkheden tijdens het verificatieproces worden vastgelegd;", x.text_en="b. identify the ultimate beneficial owner of the client and take reasonable measures to verify his identity, where the client is a legal person, take reasonable measures to gain insight into the ownership and control structure of the client, and where the ultimate beneficial owner is a member of the senior managing officials, take the necessary reasonable measures to verify the identity of the natural person who is a member of the senior managing officials, whereby the measures taken and the difficulties encountered during the verification process are recorded;", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024282/2026-07-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T2:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T3:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 2 onder c", x.topic="Purpose and nature of relationship", x.lang="nl", x.text_local="Het cliëntenonderzoek stelt de instelling in staat om: […] c. het doel en de beoogde aard van de zakelijke relatie vast te stellen;", x.text_en="The customer due diligence enables the institution to: […] c. establish the purpose and intended nature of the business relationship;", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024282/2026-07-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T3:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T4:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 2 onder d en lid 10", x.topic="Ongoing monitoring", x.lang="nl", x.text_local="d. een voortdurende controle op de zakelijke relatie en de tijdens de duur van deze relatie verrichte transacties uit te oefenen, teneinde te verzekeren dat deze overeenkomen met de kennis die de instelling heeft van de cliënt en diens risicoprofiel, met zo nodig een onderzoek naar de bron van de middelen die bij de zakelijke relatie of de transactie gebruikt worden; […] 10. Een instelling neemt redelijke maatregelen om ervoor te zorgen dat de gegevens die ingevolge het tweede tot en met vierde lid zijn verzameld over daar bedoelde personen, actueel gehouden worden.", x.text_en="d. exercise ongoing monitoring of the business relationship and of the transactions carried out during the course of that relationship, in order to ensure that these correspond to the institution's knowledge of the client and his risk profile, with, where necessary, an inquiry into the source of the funds used in the business relationship or the transaction; […] 10. An institution shall take reasonable measures to ensure that the data collected pursuant to the second to fourth paragraphs about the persons referred to there are kept up to date.", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024282/2026-07-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T4:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T5:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 2 onder d; art. 8 lid 6 onder b, 2°", x.topic="Source of funds and wealth", x.lang="nl", x.text_local="Art. 3 lid 2 onder d: […] met zo nodig een onderzoek naar de bron van de middelen die bij de zakelijke relatie of de transactie gebruikt worden; Art. 8 lid 6 onder b, 2°: passende maatregelen worden getroffen om de bron van het vermogen en van de middelen die bij deze zakelijke relatie of deze transactie gebruikt worden, vast te stellen;", x.text_en="Art. 3(2)(d): […] with, where necessary, an inquiry into the source of the funds used in the business relationship or the transaction; Art. 8(6)(b)(2°): appropriate measures are taken to establish the source of wealth and of the funds used in this business relationship or this transaction;", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024282/2026-07-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T5:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T5:2"}) SET x.jurisdiction="NL", x.ref="Wwft art. 9 lid 1 onder c", x.topic="Source of funds and wealth", x.lang="nl", x.text_local="Onverminderd artikel 8, eerste lid, verricht een instelling met betrekking tot transacties, zakelijke relaties en correspondentbankrelaties gerelateerd aan staten die op grond van artikel 9 van de vierde anti-witwasrichtlijn in gedelegeerde handelingen van de Europese Commissie zijn aangewezen als staten met een hoger risico op witwassen of financieren van terrorisme de volgende verscherpte onderzoeksmaatregelen: […] c. verzamelen van informatie over de herkomst van de fondsen die bij die zakelijke relatie of transactie gebruikt worden en de bron van het vermogen van die cliënten en van die uiteindelijk belanghebbenden;", x.text_en="Without prejudice to article 8, first paragraph, an institution shall, with respect to transactions, business relationships and correspondent banking relationships related to states designated in delegated acts of the European Commission pursuant to article 9 of the fourth anti-money laundering directive as states with a higher risk of money laundering or terrorist financing, carry out the following enhanced due diligence measures: […] c. collecting information on the origin of the funds used in that business relationship or transaction and the source of wealth of those clients and of those ultimate beneficial owners;", x.en_type="own", x.source_url="https://www.viajuridica.nl/informatiesoorten/wet-en-regelgeving/wet-ter-voorkoming-van-witwassen-en-financieren-van-terrorisme", x.verify=true;
MATCH (x:Article {id:"NL:T5:2"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T6:1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 8 lid 6", x.topic="PEPs", x.lang="nl", x.text_local="In aanvulling op de cliëntenonderzoeksmaatregelen, bedoeld in artikel 3: a. beschikt een instelling over passende risicobeheersystemen, waaronder op risico gebaseerde procedures, om te bepalen of de cliënt of de uiteindelijk belanghebbende een politiek prominente persoon is; b. past een instelling de volgende maatregelen toe bij het aangaan of voortzetten van een zakelijke relatie met of het verrichten van een transactie voor een politiek prominente persoon: 1°. voor het aangaan of voortzetten van deze zakelijke relatie of het verrichten van deze transactie, is de toestemming vereist van een persoon die deel uitmaakt van het hoger leidinggevend personeel; 2°. passende maatregelen worden getroffen om de bron van het vermogen en van de middelen die bij deze zakelijke relatie of deze transactie gebruikt worden, vast te stellen; 3°. de zakelijke relatie wordt doorlopend aan verscherpte controle onderworpen.", x.text_en="In addition to the customer due diligence measures referred to in article 3: a. an institution shall have appropriate risk management systems, including risk-based procedures, to determine whether the client or the ultimate beneficial owner is a politically exposed person; b. an institution shall apply the following measures when entering into or continuing a business relationship with, or carrying out a transaction for, a politically exposed person: 1°. entering into or continuing this business relationship or carrying out this transaction requires the approval of a person who is part of the senior managing officials; 2°. appropriate measures are taken to establish the source of wealth and of the funds used in this business relationship or this transaction; 3°. the business relationship is subjected to ongoing enhanced monitoring.", x.en_type="own", x.source_url="https://www.viajuridica.nl/informatiesoorten/wetstoelichtingen/pep-onderzoek-art-8-lid-6-wwft", x.verify=true;
MATCH (x:Article {id:"NL:T6:1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T13:1"}) SET x.jurisdiction="NL", x.ref="Uitvoeringsregeling Wwft art. 4 lid 1", x.topic="Identity documents", x.lang="nl", x.text_local="Als documenten op basis waarvan kan worden voldaan aan artikel 11, eerste lid, eerste volzin, van de wet worden aangewezen: a. een geldig paspoort; b. een geldige Nederlandse identiteitskaart; c. een geldige identiteitskaart die is afgegeven door het daartoe bevoegde gezag in een andere lidstaat en is voorzien van een pasfoto en de naam van de houder; d. een geldig Nederlands rijbewijs; e. een geldig rijbewijs dat is afgegeven door het daartoe bevoegde gezag in een andere lidstaat en is voorzien van een pasfoto en de naam van de houder; f. reisdocumenten voor vluchtelingen en vreemdelingen; g. vreemdelingendocumenten, afgegeven op grond van de Vreemdelingenwet 2000; h. een voldoende betrouwbaar identificatiemiddel.", x.text_en="Designated as documents on the basis of which article 11, first paragraph, first sentence, of the act can be complied with are: a. a valid passport; b. a valid Dutch identity card; c. a valid identity card issued by the competent authority in another member state and bearing a passport photograph and the name of the holder; d. a valid Dutch driving licence; e. a valid driving licence issued by the competent authority in another member state and bearing a passport photograph and the name of the holder; f. travel documents for refugees and aliens; g. aliens' documents issued under the Aliens Act 2000; h. a sufficiently reliable means of identification.", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0024275/2026-01-01/0", x.verify=false;
MERGE (x:Article {id:"NL:T15:1"}) SET x.jurisdiction="NL", x.ref="Wtt 2018 art. 26 lid 1 en lid 3; art. 27 lid 1", x.topic="Trust and company service providers", x.lang="nl", x.text_local="Art. 26 lid 1: Een trustkantoor heeft kennis van het doel van hetgeen de cliënt beoogt met de trustdienstverlening en onderzoekt, mede aan de hand van de uitkomst van het in dit hoofdstuk voorgeschreven cliëntenonderzoek, of aan die dienstverlening integriteitrisico’s zijn verbonden. […] Art. 26 lid 3: Een trustkantoor beschikt voor iedere cliënt over een acceptatiememorandum waarin de uitkomst van het cliëntenonderzoek, het onderzoek naar de verbonden integriteitsrisico’s en de mate waarin deze worden ondervangen in samenhang tot elkaar zijn beschreven, en waarin de aanvaarding van de cliënt tot uitdrukking is gebracht. Art. 27 lid 1: Een trustkantoor verricht voor het aangaan van een zakelijke relatie gericht op het verlenen van de trustdiensten, bedoeld in de onderdelen a en b van de begripsomschrijving van trustdienst, alsmede bij het verlenen van die trustdiensten, onderzoek naar de cliënt en de doelvennootschap.", x.text_en="Art. 26(1): A trust office shall have knowledge of the purpose the client intends with the trust services and shall examine, partly on the basis of the outcome of the customer due diligence prescribed in this chapter, whether integrity risks are associated with those services. […] Art. 26(3): A trust office shall have, for each client, an acceptance memorandum in which the outcome of the customer due diligence, the examination of the associated integrity risks and the extent to which these are mitigated are described in relation to each other, and in which the acceptance of the client is expressed. Art. 27(1): A trust office shall, before entering into a business relationship aimed at providing the trust services referred to in parts a and b of the definition of trust service, as well as when providing those trust services, carry out an examination of the client and the target company.", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0041583/2025-03-01/0", x.verify=false;
MATCH (x:Article {id:"NL:T15:1"}), (l:Law {id:"NL:wtt2018"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T13:LD1"}) SET x.jurisdiction="NL", x.ref="Wwft art. 33 lid 1 en lid 2 onderdeel a, sub 1°", x.topic="Identity documents", x.lang="nl", x.text_local="Een instelling die op grond van deze wet cliëntenonderzoek heeft verricht, […] legt op opvraagbare wijze de documenten en gegevens vast […]: de geslachtsnaam, de voornamen, de geboortedatum, het adres en de woonplaats, dan wel de plaats van vestiging van de cliënt alsmede van degene die namens die natuurlijke persoon optreedt, of een afschrift van het document dat een persoonidentificerend nummer bevat aan de hand waarvan de verificatie van de identiteit heeft plaatsgevonden;", x.text_en="An institution that has carried out customer due diligence under this Act […] records in a retrievable manner the documents and data […]: the surname, forenames, date of birth, the address and place of residence, or the place of establishment, of the client and of the person acting on behalf of that natural person, or a copy of the document containing a personal identification number on the basis of which the identity was verified;", x.en_type="own", x.source_url="https://www.viajuridica.nl/informatiesoorten/wetstoelichtingen/bewaarplicht-clientenonderzoek-art-33-wwft", x.verify=true;
MATCH (x:Article {id:"NL:T13:LD1"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:T1:LD2"}) SET x.jurisdiction="NL", x.ref="Wwft art. 3 lid 2 onderdeel e", x.topic="Customer due diligence", x.lang="nl", x.text_local="[Het cliëntenonderzoek stelt de instelling in staat:] vast te stellen of de natuurlijke persoon die de cliënt vertegenwoordigt daartoe bevoegd is en in voorkomend geval de natuurlijke persoon te identificeren en diens identiteit te verifiëren;", x.text_en="[Customer due diligence enables the institution:] to establish whether the natural person who represents the client is authorised to do so and, where applicable, to identify that natural person and verify his identity;", x.en_type="own", x.source_url="https://www.viajuridica.nl/informatiesoorten/wetstoelichtingen/identificatie-vertegenwoordiger-client-art-3-lid-2-onder-e-wwft", x.verify=true;
MATCH (x:Article {id:"NL:T1:LD2"}), (l:Law {id:"NL:wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:UBW:3"}) SET x.jurisdiction="NL", x.ref="Uitvoeringsbesluit Wwft 2018 art. 3 lid 1 onder a", x.topic="Ultimate beneficial owner (definition)", x.lang="nl", x.text_local="[…] meer dan 25 procent van de aandelen, van de stemrechten of van het eigendomsbelang […]", x.text_en="Natural persons who directly or indirectly hold more than 25 percent of the shares, voting rights or ownership interest, or control by other means (including the consolidation rules of Book 2 of the Civil Code); as a last resort the senior managing officials. (Unofficial summary.)", x.en_type="own", x.source_url="https://wetten.overheid.nl/BWBR0041193/2026-04-30/#Paragraaf2_Artikel3", x.verify=false;
MATCH (x:Article {id:"NL:UBW:3"}), (l:Law {id:"NL:uitvoeringsbesluit-wwft"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Article {id:"NL:GP:3511"}) SET x.jurisdiction="NL", x.ref="DNB Good Practices Wtt 2018, s. 3.5.7 and 3.5.11 (art. 25 Wtt 2018)", x.topic="UBO and structure (trust offices)", x.lang="nl", x.text_local="[…] zoveel mogelijk met zekerheid […] de aard en omvang van het uiteindelijk belang van de UBO’s verifieert […]", x.text_en="The trust office identifies the UBOs as far as possible with certainty, verifies their identity and the nature and size of their interest, and establishes the formal and actual control structure; a dated, verified structure chart is good practice. (Unofficial summary.)", x.en_type="own", x.source_url="https://www.dnb.nl/media/tu5l3quf/dnb-good-practice-wtt-2018-nl.pdf", x.verify=false;
MATCH (x:Article {id:"NL:GP:3511"}), (l:Law {id:"NL:dnb-gp-wtt"}) MERGE (x)-[:PART_OF]->(l);
MERGE (x:Obligation {key:"authority_to_act"}) SET x.text="Verify that the person acting on behalf of the client is authorised";
MERGE (x:Obligation {key:"directors"}) SET x.text="Identify the directors / senior managing officials";
MERGE (x:Obligation {key:"identify_ubo"}) SET x.text="Identify the beneficial owner and verify the identity";
MERGE (x:Obligation {key:"ownership_structure"}) SET x.text="Understand the ownership and control structure";
MERGE (x:Obligation {key:"pep_screening"}) SET x.text="Determine whether the client or UBO is a politically exposed person";
MERGE (x:Obligation {key:"purpose_nature"}) SET x.text="Establish the purpose and intended nature of the relationship";
MERGE (x:Obligation {key:"source_of_funds"}) SET x.text="Establish the source of the funds used in the relationship or transaction";
MERGE (x:Obligation {key:"source_of_wealth"}) SET x.text="Establish the source / composition of the wealth";
MERGE (x:Obligation {key:"trust_parties"}) SET x.text="Identify settlor, trustees, protector and beneficiaries of a trust";
MERGE (x:Obligation {key:"verify_address"}) SET x.text="Establish and verify the address / residence";
MERGE (x:Obligation {key:"verify_identity"}) SET x.text="Establish and verify the identity of the client / representative";
MERGE (x:Obligation {key:"verify_legal_entity"}) SET x.text="Verify name, legal form and existence of the legal person / arrangement";
MATCH (a:Article {id:"NL:T1:1"}), (o:Obligation {key:"verify_identity"}) MERGE (a)-[x:IMPOSES]->(o) SET x.condition="always", x.strength="implied", x.quote="identify the client and verify his identity;";
MATCH (a:Article {id:"NL:T1:2"}), (o:Obligation {key:"verify_identity"}) MERGE (a)-[x:IMPOSES]->(o) SET x.condition="always", x.strength="explicit", x.quote="If the client, the settlor of a trust, the trustee of a trust, the partner of a partnership or the person authorised in the management of the partnership is a natural person, his identity shall be verified on the basis of documents, data or information from a reliable and independent source.";
MATCH (a:Article {id:"NL:T1:2"}), (o:Obligation {key:"trust_parties"}) MERGE (a)-[x:IMPOSES]->(o) SET x.condition="always", x.strength="explicit", x.quote="If the client, the settlor of a trust, the trustee of a trust, the partner of a partnership or the person authorised in the management of the partnership is a natural person, his identity shall be verified on the basis of documents, data or information from a reliable and independent source.";
