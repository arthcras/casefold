MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:LegalForm {id:"NL:lf:bv"}) SET x.abbr="B.V. / BV", x.name="private limited liability company", x.local="besloten vennootschap met beperkte aansprakelijkheid", x.ubo_rule="Art. 3(1)(a) Uitvoeringsbesluit Wwft 2018: natural persons holding >25% of shares, voting rights or ownership interest (directly or indirectly), or exercising control by other means (incl. consolidation tests of Boek 2 BW); fallback, after exhausting all means and absent suspicion, the senior managing officials (hoger leidinggevend personeel = all statutory directors, art. 3(6)); where a legal entity is a director, look through to its directors/UBOs.", x.register="Trade Register" MERGE (x)-[:IN]->(j);
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:LegalForm {id:"NL:lf:nv"}) SET x.abbr="N.V. / NV", x.name="public limited company", x.local="naamloze vennootschap", x.ubo_rule="Same as BV (art. 3(1)(a) Uitvoeringsbesluit Wwft 2018): >25% shares/voting rights/ownership interest, incl. former bearer shares, or control by other means; fallback senior managing officials (all statutory directors). Listed NVs on a regulated market are exempt from UBO identification under the Wwft (and only register listing details).", x.register="Trade Register" MERGE (x)-[:IN]->(j);
MATCH (j:Jurisdiction {code:"NL"}) MERGE (x:LegalForm {id:"NL:lf:stichting"}) SET x.abbr="Stichting / Stg.", x.name="foundation", x.local="stichting", x.ubo_rule="Art. 3(1)(c) Uitvoeringsbesluit Wwft 2018 ('overige rechtspersoon'): natural persons with >25% ownership interest (e.g. a right to >25% of the assets/distributions), >25% of the votes on amendments of the articles, or actual control (e.g. a founder or third party with appointment/veto rights); in practice usually none, so fallback to senior managing officials = all statutory directors (bestuurders). For a STAK: also look at certificate holders as UBOs of the underlying company.", x.register="Trade Register" MERGE (x)-[:IN]->(j);
