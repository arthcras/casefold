# office.casefoldcrypto.com. Every request must carry a valid Cloudflare Access token: nginx asks the crawler service
# to verify it (/access/verify). Without CF_ACCESS_TEAM and CF_ACCESS_AUD set on the crawler, everything is refused.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    charset_types application/json application/javascript text/css;
    gzip on;
    gzip_types application/json application/javascript text/css application/wasm;
    gzip_min_length 1024;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store" always;

    auth_request /_access;

    location = /_access {
        internal;
        proxy_pass http://crawler:8090/access/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
    }
    location = /healthz { auth_request off; access_log off; }
    location = / { try_files /workspace.html =404; }

    # the crawler with the server's token: only reachable here, after Access
    location /api/crawler/ {
        proxy_pass http://crawler:8090/;
        proxy_set_header Authorization "Bearer ${CRAWLER_TOKEN}";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        client_max_body_size 64k;
    }
}
